# =============================================================================
# 生产环境配置模板
# =============================================================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 根据实际环境修改所有配置项
# 3. 确保所有敏感信息已妥善保管
# =============================================================================

# -----------------------------------------------------------------------------
# Flask 基础配置
# -----------------------------------------------------------------------------
FLASK_APP=app
FLASK_ENV=production
FLASK_DEBUG=False

# -----------------------------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------------------------
# 数据库类型选择：sqlite | mysql | postgresql
DB_TYPE=mysql

# SQLite 配置（仅适用于小型部署）
# DATABASE_URI=sqlite:///data/housing_rental.db

# MySQL 配置（推荐生产环境使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=housing_rental
MYSQL_USER=housing_user
MYSQL_PASSWORD=your-mysql-password-change-me
MYSQL_CHARSET=utf8mb4

# MySQL 连接字符串（自动构建，也可直接指定）
DATABASE_URI=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?charset=${MYSQL_CHARSET}

# PostgreSQL 配置（推荐生产环境使用）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=housing_rental
# POSTGRES_USER=housing_user
# POSTGRES_PASSWORD=your-postgres-password-change-me

# PostgreSQL 连接字符串
# DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# 数据库连接池配置
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_PRE_PING=True
SQLALCHEMY_ECHO=False

# -----------------------------------------------------------------------------
# Redis 缓存配置
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-change-me
REDIS_DB=0

# Redis 连接池配置
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=True

# 缓存配置
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=housing_rental:prod:
CACHE_ENABLED=True

# -----------------------------------------------------------------------------
# 安全密钥配置
# -----------------------------------------------------------------------------
# Flask 密钥（用于 session 签名等）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-me-in-production

# JWT 配置
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# 数据加密密钥
# Fernet 密钥（用于向后兼容）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-change-me

# AES-256-GCM 主密钥（Base64 编码的 256 位密钥）
# 生成命令：python -c "import secrets; import base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_PRIMARY_KEY=your-aes-primary-key-base64-encoded

# 密钥轮换周期（天）
AES_KEY_ROTATION_DAYS=90

# -----------------------------------------------------------------------------
# CORS 配置
# -----------------------------------------------------------------------------
# 允许的前端域名（多个用逗号分隔）
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# 文件上传配置
# -----------------------------------------------------------------------------
# 上传目录（绝对路径或相对路径）
UPLOAD_FOLDER=uploads

# 最大上传文件大小（字节）
# 100MB = 100 * 1024 * 1024 = 104857600
MAX_CONTENT_LENGTH=104857600

# 允许的文件扩展名
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,mp4,mov,avi,webm

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 慢查询日志配置
SLOW_QUERY_THRESHOLD=1.0
SLOW_QUERY_LOG_FILE=logs/slow_queries.log
SLOW_QUERY_LOG_MAX_SIZE=10485760
SLOW_QUERY_LOG_BACKUP_COUNT=10
SLOW_QUERY_MONITOR_ENABLED=True

# 加密审计日志
ENCRYPTION_AUDIT_ENABLED=True
ENCRYPTION_AUDIT_LOG_FILE=logs/encryption_audit.log

# -----------------------------------------------------------------------------
# HTTPS 安全配置
# -----------------------------------------------------------------------------
# 生产环境必须启用
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# -----------------------------------------------------------------------------
# 密码策略配置
# -----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRE_WARNING_DAYS=7
PASSWORD_MIN_UNIQUE_CHARS=4
PASSWORD_MAX_REPEATED_CHARS=3

# -----------------------------------------------------------------------------
# 备份配置
# -----------------------------------------------------------------------------
BACKUP_FOLDER=backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=True
BACKUP_COMPRESSION_ENABLED=True

# 自动备份
BACKUP_AUTO_ENABLED=True
BACKUP_AUTO_TIME=02:00
BACKUP_AUTO_FREQUENCY=daily

# 备份告警
BACKUP_ALERT_ENABLED=True
BACKUP_ALERT_EMAIL=admin@your-domain.com

# -----------------------------------------------------------------------------
# 监控与可观测性配置
# -----------------------------------------------------------------------------
# Prometheus 监控
PROMETHEUS_ENABLED=True
PROMETHEUS_PATH=/metrics

# 健康检查阈值
HEALTH_DB_RESPONSE_TIME_WARNING=1.0
HEALTH_DB_RESPONSE_TIME_CRITICAL=3.0
HEALTH_CPU_USAGE_WARNING=70
HEALTH_CPU_USAGE_CRITICAL=90
HEALTH_MEMORY_USAGE_WARNING=80
HEALTH_MEMORY_USAGE_CRITICAL=95
HEALTH_DISK_USAGE_WARNING=80
HEALTH_DISK_USAGE_CRITICAL=95
HEALTH_POOL_USAGE_WARNING=80
HEALTH_POOL_USAGE_CRITICAL=95

# 性能监控阈值
PERF_RESPONSE_TIME_WARNING=1.0
PERF_RESPONSE_TIME_CRITICAL=3.0
PERF_ERROR_RATE_WARNING=5.0
PERF_ERROR_RATE_CRITICAL=10.0
PERF_QPS_WARNING=100
PERF_QPS_CRITICAL=200

# -----------------------------------------------------------------------------
# 告警配置
# -----------------------------------------------------------------------------
# 邮件告警
ALERT_EMAIL_ENABLED=True
ALERT_EMAIL_SMTP_SERVER=smtp.your-domain.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=noreply@your-domain.com
ALERT_EMAIL_PASSWORD=your-smtp-password-change-me
ALERT_EMAIL_RECIPIENTS=admin@your-domain.com,ops@your-domain.com

# Webhook 告警
ALERT_WEBHOOK_ENABLED=False
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alert

# -----------------------------------------------------------------------------
# 调度器配置
# -----------------------------------------------------------------------------
SCHEDULER_API_ENABLED=True

# -----------------------------------------------------------------------------
# 启动任务配置
# -----------------------------------------------------------------------------
STARTUP_TASKS_ENABLED=True
STARTUP_TASKS_BATCH_SIZE=100
STARTUP_TASKS_TIMEOUT=60
STARTUP_TASKS_DELAY=100

# -----------------------------------------------------------------------------
# Gunicorn 生产服务器配置
# -----------------------------------------------------------------------------
# 工作进程数（建议设置为 CPU 核心数 * 2 + 1）
GUNICORN_WORKERS=4

# 工作线程数（每个工作进程的线程数）
GUNICORN_THREADS=2

# 绑定地址
GUNICORN_BIND=0.0.0.0:5000

# 超时时间（秒）
GUNICORN_TIMEOUT=120

# 访问日志文件
GUNICORN_ACCESSLOG=logs/access.log

# 错误日志文件
GUNICORN_ERRORLOG=logs/error.log

# 日志级别
GUNICORN_LOGLEVEL=info

# -----------------------------------------------------------------------------
# 前端配置
# -----------------------------------------------------------------------------
# 是否显示演示账号（生产环境必须设置为 false）
VITE_SHOW_DEMO_ACCOUNT=false
