# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
# SQLite (default)
DATABASE_URI=sqlite:///housing_rental.db

# MySQL (uncomment to use)
# DATABASE_URI=mysql+pymysql://username:password@localhost:3306/housing_rental

# PostgreSQL (uncomment to use)
# DATABASE_URI=postgresql://username:password@localhost:5432/housing_rental

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Scheduler
SCHEDULER_API_ENABLED=True

# Encryption (敏感数据加密)
# 生成新密钥: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-change-in-production

# HTTPS Security (生产环境)
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=True

# Cache Settings
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=housing_rental:
CACHE_ENABLED=True

# Frontend Configuration (前端配置)
# 是否显示演示账号（生产环境建议设置为 false）
VITE_SHOW_DEMO_ACCOUNT=false
