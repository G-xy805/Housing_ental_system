# ============================================
# Docker 部署环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.docker .env
# ============================================

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=root_password_change_me_in_production
MYSQL_DATABASE=housing_rental
MYSQL_USER=housing_user
MYSQL_PASSWORD=housing_password_change_me_in_production
MYSQL_PORT=3306

# ============================================
# Redis 缓存配置
# ============================================
REDIS_PASSWORD=redis_password_change_me_in_production
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Flask 应用配置
# ============================================
# 安全密钥（生产环境必须修改！）
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-use-openssl-rand-hex-32

# ============================================
# 数据库连接池配置
# ============================================
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_TIMEOUT=30

# ============================================
# Redis 连接配置
# ============================================
REDIS_MAX_CONNECTIONS=50

# ============================================
# 缓存配置
# ============================================
CACHE_ENABLED=True
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=housing_rental:

# ============================================
# CORS 配置
# ============================================
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5000

# ============================================
# 文件上传配置
# ============================================
MAX_CONTENT_LENGTH=104857600

# ============================================
# 备份配置
# ============================================
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=True
BACKUP_COMPRESSION_ENABLED=True
BACKUP_AUTO_ENABLED=True
BACKUP_AUTO_TIME=02:00

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
SLOW_QUERY_THRESHOLD=1.0
SLOW_QUERY_MONITOR_ENABLED=True

# ============================================
# 监控配置
# ============================================
PROMETHEUS_ENABLED=True

# ============================================
# 加密配置
# ============================================
ENCRYPTION_KEY=change-this-encryption-key-in-production
# AES 主密钥（Base64 编码的 256 位密钥，可选）
# AES_PRIMARY_KEY=
AES_KEY_ROTATION_DAYS=90

# ============================================
# 密码策略配置
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_COUNT=5

# ============================================
# HTTPS 安全配置
# ============================================
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True

# ============================================
# 启动任务配置
# ============================================
STARTUP_TASKS_ENABLED=True

# ============================================
# 端口配置
# ============================================
BACKEND_PORT=5000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# 告警配置（可选）
# ============================================
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_SMTP_SERVER=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

ALERT_WEBHOOK_ENABLED=False
ALERT_WEBHOOK_URL=
